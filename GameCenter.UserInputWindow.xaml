<Window x:Class="GameCenter.UserInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Center" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
      
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1F1F1F" Offset="0"/>
                <GradientStop Color="#3A3A3A" Offset="0.5"/>
                <GradientStop Color="#7E7E7E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

       
        <TextBlock Text="Game Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"/>

       
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          
            <TextBox x:Name="NameTextBox"
         Width="250"
         Height="35" 
                FontSize="16"
         Padding="8,4"
              
                Background="#F5F5F5"
         Foreground="#1F1F1F"
         BorderBrush="#7E7E7E"
         BorderThickness="1"
         VerticalContentAlignment="Center"
         GotFocus="NameTextBox_GotFocus"
         LostFocus="NameTextBox_LostFocus"
         Margin="0,0,0,10"/>
        </StackPanel>

       
        <Button Content="Submit"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Width="120"
                Height="40"
                Margin="0,0,0,30"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Background="#3A3A3A"
                BorderBrush="Transparent"
                Click="SubmitButton_Click">
          
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="15"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                   
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#7E7E7E"/>
                            <Setter Property="Foreground" Value="#1F1F1F"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>

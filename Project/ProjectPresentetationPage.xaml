<Window x:Class="GameCenter.Project.ProjectPresentetationPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Project Presentation Page" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        >
    

    <Grid Style="{StaticResource GridStyles}">
       
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.6*"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
            <Image x:Name="UserProfilePicture" Width="60" Height="60" Source="/Images/profile.png" Margin="10"/>
            <TextBlock x:Name="UserNameTextBlock" HorizontalAlignment="Left" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="16"/>
        </StackPanel>

       
        <Label x:Name="addUserTitle"
               Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
               VerticalContentAlignment="Center"
               Content="Game Center"
               HorizontalContentAlignment="Center"
               Foreground="White"
               FontWeight="Bold"
               FontSize="40"/>

       
        <Label x:Name="DateLabel"
               Content="Date"
               Grid.Row="0" 
               Grid.Column="2"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Foreground="White"
               FontFamily="Arial Black"
               Width="180"
               FontSize="11" Margin="0,20,20,0"/>

       
        <Image x:Name="ProjectImage"
               Grid.Column="0"
               Grid.Row="2"
               Width="150"
               Height="150"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="25"
               MouseEnter="ProjectImage_MouseEnter"
               MouseLeave="ProjectImage_MouseLeave"
               MouseLeftButtonUp="ProjectImage_MouseLeftButtonUp"/>

      
        <RichTextBox x:Name="ProjectText"
                     Grid.Column="1"
                     Grid.Row="2"
                     Grid.ColumnSpan="2"
                     FontSize="16"
                     Foreground="White"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"/>

       
        <Label x:Name="Footer"
               Grid.Column="0"
               Grid.Row="3"
               Grid.ColumnSpan="3"
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Center"
               Foreground="White"
               FontWeight="Bold"
               FontSize="23"
               Content="Game Center © 2024"/>
    </Grid>
</Window>
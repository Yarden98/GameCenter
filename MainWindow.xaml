<Window x:Class="GameCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameCenter"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F1F1F" Offset="0"/>
                <GradientStop Color="#3A3A3A" Offset="0.5"/>
                <GradientStop Color="#7E7E7E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20">
            <Image x:Name="UserProfilePicture" Width="80" Height="80" Source="/Images/profile.png"  />
            <TextBlock x:Name="UserNameTextBlock" Text="User Name" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="16"/>
        </StackPanel>


        <Label x:Name="DateLabel"
               Content="Date and Time"
               Grid.Row="0"
               Grid.Column="2"
               Foreground="White"
               HorizontalContentAlignment="Right"
               VerticalContentAlignment="Center"
               FontFamily="Arial Black"
               FontSize="20" Margin="0,20,20,0"/>

        <TextBlock x:Name="DateTimeTextBlock"
                   Grid.Row="1"
                   Grid.Column="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Foreground="White"
                   Margin="0,0,20,0"/>

      

        <Label x:Name="addUserTitle"
               Grid.Column="0"
               Grid.Row="0"
               Grid.ColumnSpan="3"
               VerticalContentAlignment="Center"
               Content="Game Center" 
               HorizontalContentAlignment="Center" 
               Foreground="White"
               FontWeight="Bold"
               FontSize="60"/>

        <Label 
      x:Name="GameText"
      Content="please pick a game" 
      Foreground="White"
      Grid.Row="1" 
      Grid.Column="1" 
      VerticalAlignment="Center" 
      HorizontalAlignment="Center"
      FontSize="26"
  />

        <UniformGrid Grid.Row="2" Grid.Column="1" Columns="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
            <StackPanel Margin="20">
                <Image x:Name="Image1" Source="/Images/system.png" Width="150" Height="150" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseLeftButtonUp="EnterGame1_Click"/>
            </StackPanel>

            <StackPanel Margin="20">
                <Image x:Name="Image2" Source="/Images/todolit.png" Width="150" Height="150" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseLeftButtonUp="EnterGame2_Click"/>
            </StackPanel>

            <StackPanel Margin="20">
                <Image x:Name="Image3" Source="/Images/currency.png" Width="150" Height="150" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseLeftButtonUp="EnterGame3_Click"/>
            </StackPanel>

            <StackPanel Margin="20">
                <Image x:Name="Image4" Source="/Images/tictactoe.png" Width="150" Height="150" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseLeftButtonUp="EnterGame4_Click"/>
            </StackPanel>

            <StackPanel Margin="20">
                <Image x:Name="Image5" Source="/Images/microcar.png" Width="150" Height="150" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseLeftButtonUp="EnterGame5_Click"/>
            </StackPanel>

            <StackPanel Margin="20">
                <Image x:Name="Image6" Source="/Images/calculator2.png" Width="150" Height="150" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseLeftButtonUp="EnterGame6_Click"/>
            </StackPanel>
        </UniformGrid>



        <Label x:Name="Footer"
               Grid.Column="0"
               Grid.Row="3"
               Grid.ColumnSpan="3"
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Center"
               Foreground="White"
               FontWeight="Bold"
               FontSize="23"
               Content="Game Center © 2024"/>
    </Grid>
</Window>